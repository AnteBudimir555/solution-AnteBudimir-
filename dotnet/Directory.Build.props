<Project>
  <!--
    Shared build settings for the whole migration solution. Targets .NET 10 (LTS), the runtime
    MIGRATION_PLAN §2.1 specifies. Phases 1-5 were built against the plan's sanctioned .NET 8
    fallback, that being the only SDK installed at the time; this is the move to the intended
    target. Projects inherit the framework from here rather than restating it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
