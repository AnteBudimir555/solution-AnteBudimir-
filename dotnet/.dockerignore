# Build output — the image rebuilds it from source inside the build stage. Copying host artifacts in
# would also mix a Windows-built obj/ into a Linux container and break the restore.
**/bin/
**/obj/

# Local dev database file created by `dotnet run`.
**/*.db

# Not part of the published service: the test projects and the parity harness.
tests/
tools/

# Local tooling / IDE / VCS metadata not needed in the build context.
.vs/
.vscode/
.idea/
.config/
