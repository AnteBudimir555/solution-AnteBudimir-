<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Middleware.Core\Middleware.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Typed HttpClient factory for the DummyJSON upstream adapter (base address + timeouts). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- BCrypt password hashing: kept so hashes migrated from the Java service verify unchanged. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- HS256 issue/validate for locally-minted tokens (the jjwt replacement). -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <!-- IHostedService for the startup schema initializer and the user seeder. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <!-- ValidateDataAnnotations()/ValidateOnStart(): the JWT-secret fail-fast at start-up. -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <!--
      Not used directly: EF Core Sqlite resolves SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries a
      known high-severity advisory (GHSA-2m69-gcr7-jv3q). A direct reference lifts the transitive
      resolution to the patched build without moving to the 3.x line. Remove once the EF Core
      dependency itself points at a patched version.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
</Project>
