<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!--
      OpenAPI: Swashbuckle generates both the document and the UI. .NET 10 does ship an in-box
      document generator (Microsoft.AspNetCore.OpenApi's AddOpenApi), which would allow the Scalar
      setup the migration plan sketches; that swap is deliberately not folded into the framework
      bump, since it would rewrite the operation/schema filters that pin the document to the Java
      contract. The version tracks the runtime: Swashbuckle 10.x is the line built against
      Microsoft.OpenApi 2.x, which is what ASP.NET Core 10 resolves.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Bearer authentication middleware (replaces the custom Spring Security JWT filter). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Request validation with explicit, Hibernate-Validator-compatible messages. -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <!-- Structured logging: LogContext = SLF4J MDC; compact JSON = the logstash encoder. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!--
      Not used directly: the OpenAPI packages resolve Microsoft.OpenApi 2.0.0, which carries a known
      high-severity advisory (GHSA-v5pm-xwqc-g5wc). A direct reference lifts the transitive resolution
      to a patched build, staying on the 2.x line that ASP.NET Core 10 is built against.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Middleware.Infrastructure\Middleware.Infrastructure.csproj" />
  </ItemGroup>

</Project>
