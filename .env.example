# Copy to .env before `docker compose up`:  cp .env.example .env
# docker compose auto-loads .env from this directory. The real .env is gitignored.
#
# Two keys below are intentionally EMPTY. Copying this file is not enough on its own — Compose
# refuses to start until you fill them in. That is the point: a value committed here would be a
# published credential, and the stack runs an internet-shaped Production profile. Generate them:
#
#   printf 'JWT_SECRET=%s\n'         "$(openssl rand -base64 48)" >> .env
#   printf 'SEED_USER_PASSWORD=%s\n' "$(openssl rand -base64 18)" >> .env

# Postgres credentials for the container the app talks to. These keep throwaway values on purpose:
# the database is reachable only over the internal Compose network and a loopback-bound host port,
# it holds nothing but the demo user table, and the volume is disposable. Nothing outside this stack
# can present them to anything.
DB_USERNAME=middleware
DB_PASSWORD=middleware

# HS256 signing key, >= 32 bytes. No value ships here: whoever holds it can mint a valid token for
# any user and any role, so a shared one is worse than a shared password.
JWT_SECRET=

# Password for the seeded demo account (username defaults to `demo`; override with
# SEED_USER_USERNAME). No value ships here either — this account can log in to the running API.
SEED_USER_PASSWORD=
